{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://se-z.stealtheye.io/schemas/sez1-receipt-v1.json",
  "title": "SEZ1 signed result receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptFormatVersion", "requestDigest", "resultDigest", "requestId", "operation", "subject", "authorityClass", "authorityGeneration", "catalogDigest", "hostIdentity", "releaseIdentity", "acceptedAt", "terminalAt", "state", "jobId", "stdoutDigest", "stderrDigest", "artifactDigests", "receiptKeyId", "receiptId", "signature"],
  "properties": {
    "receiptFormatVersion": {"const": "1.0.0"},
    "requestDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resultDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requestId": {"type": "string", "format": "uuid"},
    "operation": {"type": "string", "pattern": "^sez\\."},
    "subject": {"const": "stealtheye-owner"},
    "authorityClass": {"const": "unrestricted-owner"},
    "authorityGeneration": {"type": "integer", "minimum": 1},
    "catalogDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hostIdentity": {"type": "object"},
    "releaseIdentity": {"type": "object"},
    "acceptedAt": {"type": "string", "format": "date-time"},
    "terminalAt": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
    "state": {"enum": ["accepted", "running", "completed", "failed", "cancelled", "lost", "ambiguous", "reconciled"]},
    "jobId": {"oneOf": [{"type": "null"}, {"type": "string", "format": "uuid"}]},
    "stdoutDigest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "stderrDigest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "artifactDigests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "receiptKeyId": {"type": "string", "minLength": 1, "maxLength": 128},
    "receiptId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
  }
}
