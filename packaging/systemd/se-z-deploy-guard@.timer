# Provenance: exact pinned source and transformation are recorded in vendor/baby-provenance/file-map.json.
[Unit]
Description=Persistent se-z standalone deployment rollback deadline for %i
Documentation=https://github.com/StealthEyeLLC/se-z

[Timer]
OnBootSec=15s
OnUnitActiveSec=15s
AccuracySec=1s
Persistent=true
Unit=se-z-deploy-guard@%i.service

[Install]
WantedBy=timers.target
