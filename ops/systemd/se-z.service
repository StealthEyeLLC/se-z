[Unit]
Description=se-z unrestricted UID-0 supervisor
Requires=se-z-gateway.socket se-z-local.socket
After=local-fs.target

[Service]
Type=notify
User=root
Group=root
ExecStart=/opt/se-z/current/bin/se-z-supervisor
Restart=on-failure
RestartSec=1
KillMode=mixed
UMask=0077
LimitNOFILE=1048576

# The supervisor intentionally retains full host authority. Do not add capability,
# namespace, filesystem, device, or privilege restrictions that remove the
# product's intended UID-0 capability.

[Install]
WantedBy=multi-user.target
