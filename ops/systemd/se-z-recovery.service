[Unit]
Description=se-z independent recovery and fencing authority
After=local-fs.target

[Service]
Type=notify
User=root
Group=root
ExecStart=/opt/se-z-recovery/current/bin/se-z-recovery
Restart=on-failure
RestartSec=1
UMask=0077
StateDirectory=se-z-recovery
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
